# ==============================================================================
# SansKrypt Environment Variables Example
# Duplicate this file as .env and fill in your actual API keys and secrets.
# ==============================================================================

# Google Gemini API Key for OCR transcription, translation & explanation
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Flask Secret Key for session security
SECRET_KEY=your_secret_key_here

# Optional: Custom path to Tesseract OCR binary if not in PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: Model Configuration overrides
# TRANSLATION_MODEL=google/flan-t5-small
# LLM_MODEL=google/flan-t5-small
