# Google Gemini API Key for LLM translation, contextual explanation & classification
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key for session security
SECRET_KEY=sanskrypt-major-secret-key-2026

# Optional Model Configuration overrides
# TRANSLATION_MODEL=google/flan-t5-small
# LLM_MODEL=google/flan-t5-small
